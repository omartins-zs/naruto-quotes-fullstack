# Deixe ativo apenas UM bloco por vez.
# VITE_API_URL e relativo nos dois modos: em dev o proxy do Vite redireciona
# e em Docker o nginx faz o mesmo. So muda para onde o /api aponta.

# LOCAL
CLIENT_PORT=3000
VITE_API_URL=/api
API_PROXY_TARGET=http://localhost:3333

# DOCKER
# CLIENT_PORT=3000
# VITE_API_URL=/api
# API_PROXY_TARGET=http://api:3333
