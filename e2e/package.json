{
  "name": "naruto-quotes-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Testes end-to-end do Naruto Quotes com Playwright",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
