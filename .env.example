# Portas publicadas pelo docker compose na sua maquina.
# Copie este arquivo para .env antes de subir os containers.

APP_PORT=8080
API_PORT=3333

# Caminho relativo: o nginx encaminha /api para o container da API.
VITE_API_URL=/api

# Origens permitidas pelo CORS da API. Use * apenas em desenvolvimento.
CORS_ORIGINS=*
